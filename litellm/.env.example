# Copy this file to litellm/.env and replace the values.
# Use one normal OpenRouter API key per account (sk-or-v1-...).
OPENROUTER_API_KEY_1=sk-or-v1-replace-account-1
OPENROUTER_API_KEY_2=sk-or-v1-replace-account-2
OPENROUTER_API_KEY_3=sk-or-v1-replace-account-3
OPENROUTER_API_KEY_4=sk-or-v1-replace-account-4
OPENROUTER_API_KEY_5=sk-or-v1-replace-account-5
